# API
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://sms:sms@localhost:5433/sms_challenge

# Redis
REDIS_URL=redis://localhost:6379

# Twilio (use TWILIO_USE_MOCK=true for local dev — no real credentials needed)
TWILIO_USE_MOCK=true
TWILIO_MOCK_DELAY_MIN=3000
TWILIO_MOCK_DELAY_MAX=15000
TWILIO_MOCK_FAIL_RATE=0

# Set these only when TWILIO_USE_MOCK=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Signature validation — set true in production
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_WEBHOOK_URL=http://localhost:3000/webhook/sms
